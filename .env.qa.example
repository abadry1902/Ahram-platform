# COPY TO .env.qa.local (never commit .env.qa.local)
# Dedicated disposable AL AHRAM QA project ONLY; do NOT use production or another brand's Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-QA-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
QA_PROJECT_REF=YOUR-QA-PROJECT-REF
# Owner must approve the actual project; this declaration cannot detect production automatically.
QA_PROJECT_PURPOSE=AL_AHRAM_DISPOSABLE_QA

# Four isolated fictitious users, created by an authorized admin in Supabase Auth.
QA_SUPERVISOR_EMAIL=supervisor.qa@example.test
QA_SUPERVISOR_PASSWORD=
QA_EMPLOYEE_A_EMAIL=employee-a.qa@example.test
QA_EMPLOYEE_A_PASSWORD=
QA_EMPLOYEE_B_EMAIL=employee-b.qa@example.test
QA_EMPLOYEE_B_PASSWORD=
QA_EDITOR_EMAIL=editor.qa@example.test
QA_EDITOR_PASSWORD=

# Destructive/mutating test gate: leave blank for read-only tests.
# Set only when this is an approved dedicated DISPOSABLE QA project.
QA_MUTATION_CONFIRM=

# Do NOT put SUPABASE_SERVICE_ROLE_KEY in this file. Tests use user sessions only.
